<mujoco model="h1 handless scene with table">
  <include file="h1_2_handless.xml"/>

  <statistic center="0.6 0.0 1.2" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_top_mat"  rgba="0.55 0.35 0.20 1" reflectance="0.05"/>
    <material name="table_leg_mat"  rgba="0.30 0.20 0.10 1" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Static table in front of the robot.  Top surface plane z = 1.05 m. -->
    <body name="table" pos="0.55 0.0 0.0">
      <geom name="table_top"    type="box" size="0.35 0.35 0.02" pos="0 0 1.03" material="table_top_mat"/>
      <geom name="table_leg_fl" type="box" size="0.02 0.02 0.505" pos=" 0.32  0.32 0.505" material="table_leg_mat"/>
      <geom name="table_leg_fr" type="box" size="0.02 0.02 0.505" pos=" 0.32 -0.32 0.505" material="table_leg_mat"/>
      <geom name="table_leg_bl" type="box" size="0.02 0.02 0.505" pos="-0.32  0.32 0.505" material="table_leg_mat"/>
      <geom name="table_leg_br" type="box" size="0.02 0.02 0.505" pos="-0.32 -0.32 0.505" material="table_leg_mat"/>
    </body>
  </worldbody>
</mujoco>
